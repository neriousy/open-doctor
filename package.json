{
  "name": "open-doctor-workspace",
  "version": "0.0.3",
  "description": "Support toolkit for repairing and inspecting local OpenCode data",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@opentui/core": "0.4.0",
      "@opentui/react": "0.4.0",
      "@tanstack/react-query": "5.101.0",
      "@types/node": "24.12.2",
      "@types/react": "19.2.17",
      "@types/yargs": "17.0.35",
      "effect": "4.0.0-beta.74",
      "esbuild": "0.28.0",
      "react": "19.2.7",
      "react-devtools-core": "7.0.1",
      "turbo": "2.9.17",
      "typescript": "5.8.2",
      "ws": "8.21.0",
      "yargs": "18.0.0"
    }
  },
  "scripts": {
    "build": "bun turbo build",
    "check": "bun turbo typecheck",
    "start": "bun run --cwd packages/open-doctor start",
    "pack:cli": "bun run --cwd packages/open-doctor pack:npm",
    "doctor": "bunx react-doctor@latest"
  },
  "devDependencies": {
    "@opentui/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/yargs": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-devtools-core": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ws": "catalog:",
    "yargs": "catalog:"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.14"
}

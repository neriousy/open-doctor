{
  "name": "open-doctor",
  "version": "0.0.3",
  "description": "Support toolkit for repairing and inspecting local OpenCode data",
  "type": "module",
  "bin": {
    "open-doctor": "bin/open-doctor"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun ./script/build.ts",
    "pack:npm": "bun ./script/stage-npm.ts && cd .release/open-doctor && bun pm pack",
    "publish:npm": "bun ./script/stage-npm.ts && cd .release/open-doctor && npm publish *.tgz",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@opentui/core": "catalog:",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@open-doctor/core": "workspace:*",
    "@open-doctor/tui": "workspace:*",
    "@opentui/react": "catalog:",
    "@types/yargs": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "yargs": "catalog:"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "MIT"
}

{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@open-doctor/core": ["packages/core/src/index.ts"],
      "@open-doctor/core/*": ["packages/core/src/*"],
      "@open-doctor/tui": ["packages/tui/src/index.tsx"],
      "@open-doctor/tui/*": ["packages/tui/src/*"]
    }
  }
}
